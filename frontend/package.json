{
  "name": "aiops-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AIOPS 智能运维平台前端",
  "scripts": {
    "dev": "node ./scripts/dev-runner.cjs",
    "build": "max build",
    "build:analyze": "ANALYZE=1 max build",
    "postinstall": "max setup",
    "start": "npm run dev",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:css": "stylelint \"src/**/*.{css,less}\"",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,css,less}\"",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.0",
    "@ant-design/icons": "^5.5.0",
    "@ant-design/pro-components": "^2.8.0",
    "@ant-design/x": "^1.2.0",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@umijs/max": "^4.4.0",
    "@xyflow/react": "^12.4.0",
    "antd": "^5.22.0",
    "antd-style": "^3.7.0",
    "dayjs": "^1.11.0",
    "dompurify": "^3.2.0",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.17.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.0",
    "stylelint": "^16.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.47.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
