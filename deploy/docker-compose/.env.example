# ============================================================
# 星枢 K8S 管理平台 - docker-compose 环境变量模板
#
# 用法：cp .env.example .env，然后编辑 .env（生产必须修改所有密钥）
#
# 密钥生成参考（32 字节随机串，任选其一）：
#   Linux/macOS : openssl rand -hex 32
#   Windows     : PowerShell 执行
#     [System.Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#
# 注意：密码中若包含 $ @ / 等特殊字符，请先对 DSN 进行 URL 转义，
# 或直接使用字母数字+常见符号的强密码，避免拼接 MYSQL_DSN 出错。
# ============================================================

# ---------- 数据库 ----------
# MySQL root 密码（首次启动后修改需同步改 DSN）
MYSQL_ROOT_PASSWORD=Root@123456
# 业务数据库名（必须与 MYSQL_DSN 中的库名一致，compose 会自动创建）
MYSQL_DATABASE=k8splatform

# ---------- 鉴权与加密（务必修改）----------
# JWT 签名密钥（>=32 字节）
JWT_SECRET=dev_please_change_jwt_secret_32bytes_min
# 敏感数据加密主密钥（AES-256-GCM，>=32 字节；不配置则回退使用 JWT_SECRET）
CRYPTO_MASTER_KEY=dev_please_change_crypto_master_key_32b
# 内置管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ---------- Redis ----------
REDIS_PASSWORD=Redis@123456
