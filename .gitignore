# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# ------------------------------
# Go binaries and build outputs
# ------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a

# Common local build folders
bin/
dist/
tmp/
*.zip

# Test binary, built with go test -c
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# ------------------------------
# Frontend (Node.js / Vite)
# ------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
frontend/src/.umi/
frontend/src/.umi-production/
frontend/.aiops-dev.lock

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.umi


# ------------------------------
# Environment and local config
# ------------------------------
.env
.env.*
!.env.example
backend/config.yaml
backend/config.local.yaml
!backend/config.example.yaml
.tmp-go-cache
# Local runtime data / sqlite / logs
*.db
*.sqlite
*.sqlite3
*.log

# ------------------------------
# Editor / IDE
# ------------------------------
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# ------------------------------
# OS generated files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode
plan.md
allplan.md
*.md
!docs/automated-k8s-deployment-design.md
!docs/architecture-refactor-plan.md
!docs/architecture-refactor-plan-v2.md
!docs/project-architecture.md
!backend/internal/README.md
!frontend/src/features/README.md
.tmp-go-build
.tmp-go-cache
.tmp-go-test
.trae
.agents
.tmp-go-test-resourcecreator
